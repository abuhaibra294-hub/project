# Copy to .env.staging ON YOUR OWN SERVER ONLY, chmod 600, NEVER COMMIT.
# A real domain and DNS A record pointing to the staging VPS are required.
DARECARE_DOMAIN=api-staging.example.com
FRONTEND_ORIGIN=https://web-staging.example.com
# External SQL Server; encrypt connections in transit. Provision DB separately.
ConnectionStrings__DefaultConnection=Server=tcp:YOUR_SQL_HOST,1433;Database=DareCareStaging;User Id=YOUR_DB_USER;Password=REPLACE_WITH_SECRET;Encrypt=True;TrustServerCertificate=False;
Jwt__Key=REPLACE_WITH_SECURE_RANDOM_48_BYTE_BASE64_STRING
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__FromEmail=no-reply@example.com
Smtp__Username=SET_EMAIL_USERNAME
Smtp__Password=REPLACE_WITH_SECRET
# Optional ONLY for first Staging boot; set false and delete credentials after bootstrap.
BootstrapAdmin__AllowOneTimeStaging=false
BootstrapAdmin__Email=
BootstrapAdmin__Password=
