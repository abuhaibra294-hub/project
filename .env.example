# DOCUMENTATION ONLY. Store actual values using dotnet user-secrets (dev) or secret manager (deployment).
ConnectionStrings__DefaultConnection=SET_IN_USER_SECRETS_OR_DEPLOYMENT
Jwt__Key=GENERATE_AT_LEAST_32_RANDOM_BYTES_IN_USER_SECRETS
Jwt__Issuer=DareCare.Api
Jwt__Audience=DareCare.Clients
Jwt__ExpiryMinutes=15
Auth__RefreshTokenDays=14
# Development default false, non-development default true.
Auth__RequireConfirmedEmail=true
Smtp__Host=CONFIGURE_MAIL_SERVER
Smtp__Port=587
Smtp__FromEmail=no-reply@YOUR_REAL_DOMAIN
Smtp__Username=MAILBOX_USER
Smtp__Password=MAILBOX_PASSWORD
Smtp__EnableSsl=true
# Optional DEVELOPMENT-only admin bootstrap
BootstrapAdmin__Email=LOCAL_ONLY
BootstrapAdmin__Password=LOCAL_ONLY
